datasource db {
  provider  = "cockroachdb"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Message {
  id                 String        @id @default(cuid())
  slug               String        @unique
  title              String
  summary            String
  description        String
  type               MessageType
  status             MessageStatus @default(DRAFT)
  placement          MessagePlacement @default(STANDARD)
  speaker            String?
  scriptureReference String?
  eventDate          DateTime?
  coverImageKey      String?
  mediaKey           String?
  externalMediaUrl   String?   // YouTube, Facebook, or direct media URL
  audioDownloadKey   String?   // Optional audio download for video messages
  durationSeconds    BigInt?
  publishedAt        DateTime?
  categoryId         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  category           Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([eventDate])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model ContactSubmission {
  id          String    @id @default(cuid())
  name        String
  email       String
  message     String
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([createdAt])
}

/// A resource in the Resources library. The model and table keep the name
/// "Book" for backward compatibility with existing data; `resourceType`
/// distinguishes Books from Devotionals, Pastor's Pulpit, and Articles.
model Book {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  tagline      String
  description  String
  author       String
  coverImageKey String?
  /// R2 object key for a resource file uploaded from an admin device (PDF, EPUB…).
  downloadKey  String?
  /// Original file name of the uploaded resource, used for the download filename.
  downloadFileName String?
  /// Optional external download link — used when no file was uploaded.
  downloadUrl  String?
  purchaseUrl  String?
  priceLabel   String?
  format       String?
  pageCount    Int?
  featured     Boolean       @default(false)
  availability BookAvailability @default(FREE)
  resourceType ResourceType  @default(BOOK)
  status       MessageStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([availability])
  @@index([resourceType, status, publishedAt])
}

model Quote {
  id                 String        @id @default(cuid())
  slug               String        @unique
  title              String
  text               String
  attribution        String?
  source             String?
  scriptureReference String?
  imageKey           String?
  featured           Boolean       @default(false)
  status             MessageStatus @default(DRAFT)
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, publishedAt])
}

model AdminUser {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  emailVerified DateTime?
  /// bcrypt hash of the 6-digit verification code. Never stored in the clear,
  /// because a 6-digit code is only a million guesses wide.
  verifyToken       String?
  verifyTokenExpiry DateTime?
  /// Wrong guesses against the current code; the code dies at the cap.
  verifyAttempts    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  auditLogs         AuditLog[]
}

/// A member of the public who registered on the site. Distinct from AdminUser:
/// these accounts hold a personal bcrypt password and carry no admin rights.
model SiteUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  status       SiteUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  /// bcrypt hash of the 6-digit password-reset code, with its expiry and a
  /// wrong-guess counter. Cleared the moment the password is reset.
  resetCodeHash   String?
  resetCodeExpiry DateTime?
  resetAttempts   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  comments        Comment[]
  likes           Like[]
  commentReports  CommentReport[]

  @@index([createdAt])
}

enum SiteUserStatus {
  ACTIVE
  SUSPENDED
}

model AuditLog {
  id         String    @id @default(cuid())
  adminId    String
  adminEmail String
  action     String    // e.g. "message.create", "book.delete", "admin.register"
  entityType String    // "Message" | "Book" | "Quote" | "AdminUser"
  entityId   String?
  detail     String?   // JSON summary of key changed fields
  ip         String?
  createdAt  DateTime  @default(now())
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([entityType, createdAt])
  @@index([createdAt])
}

/// A person serving in the ministry, shown on the public /team page.
/// Ordering is by role hierarchy first (see TeamRole), then sortOrder, then name.
model TeamMember {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  /// Hierarchy band. ANCHOR leads the page and is rendered as the lead card.
  role               TeamRole      @default(MEMBER)
  /// Free-text title shown under the name, e.g. "Ministry Anchor".
  title              String
  bio                String?
  photoKey           String?
  email              String?
  phone              String?
  facebookUrl        String?
  youtubeUrl         String?
  whatsappNumber     String?
  /// An optional verse the member is known for, shown on their card.
  scriptureVerse     String?
  scriptureReference String?
  /// Manual ordering inside a role band; lower comes first.
  sortOrder          Int           @default(0)
  status             MessageStatus @default(DRAFT)
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, role, sortOrder])
}

/// Ministry role hierarchy, declared most senior first. The public page groups
/// members in this order, so adding a value means placing it deliberately.
enum TeamRole {
  ANCHOR
  PASTOR
  ELDER
  COORDINATOR
  MEDIA
  MEMBER
}

enum MessageType {
  VIDEO
  AUDIO
  IMAGE
}

enum MessageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MessagePlacement {
  STANDARD
  HERO
}

enum BookAvailability {
  FREE
  PAID
}

/// The four sections of the public Resources library.
enum ResourceType {
  BOOK
  DEVOTIONAL
  PULPIT
  ARTICLE
}

/// Owner-editable site configuration (contact details, social handles).
/// Stored as one row per key so new settings need no migration.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// History of ministry emails composed and sent by an admin from
/// Admin -> Compose Email. Kept so admins can review or remove past sends.
model SentEmail {
  id                 String   @id @default(cuid())
  subject            String
  bodyText           String
  scriptureVerse     String?
  scriptureReference String?
  recipients         String[]
  sentCount          Int
  failedCount        Int      @default(0)
  sentByEmail        String
  sentByName         String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

/// A pending passwordless sign-in. One row per address: requesting a new code
/// replaces the old one. The member account itself is only created once the
/// code is proven, so unverified addresses never become accounts.
model EmailCode {
  email     String   @id
  /// Name given at request time, used only if the account is new.
  name      String?
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

/// Anything people can like, comment on, or engage with.
enum TargetKind {
  MESSAGE
  RESOURCE
  QUOTE
  COMMENT
}

enum CommentStatus {
  VISIBLE
  /// Waiting for an admin — seen only by its author until approved.
  HELD
  HIDDEN
}

model Comment {
  id          String        @id @default(cuid())
  /// MESSAGE, RESOURCE or QUOTE — never COMMENT; replies use parentId.
  targetKind  TargetKind
  targetId    String
  userId      String
  /// One level of replies: a reply's parent is always a top-level comment.
  parentId    String?
  body        String
  status      CommentStatus @default(VISIBLE)
  /// Why it was held, e.g. "link", "first comment", "reported".
  heldReason  String?
  reportCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        SiteUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("CommentReplies")
  reports     CommentReport[]

  @@index([targetKind, targetId, status, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([parentId])
}

model CommentReport {
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      SiteUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

/// One like per person per item — content or a comment.
model Like {
  id         String     @id @default(cuid())
  targetKind TargetKind
  targetId   String
  userId     String
  createdAt  DateTime   @default(now())
  user       SiteUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([targetKind, targetId, userId])
  @@index([targetKind, targetId])
  @@index([userId, createdAt])
}

enum EngagementType {
  VIEW
  PLAY
  DOWNLOAD
  LIKE
  COMMENT
}

/// First-party engagement analytics. Anonymous visitors carry only a random
/// first-party id plus coarse country and device — never an IP address.
model EngagementEvent {
  id         String         @id @default(cuid())
  type       EngagementType
  targetKind TargetKind?
  targetId   String?
  path       String?
  /// Signed-in member, when there is one.
  userId     String?
  visitorId  String
  /// ISO 3166-1 alpha-2, from the edge's geo header.
  country    String?
  /// "mobile" | "tablet" | "desktop"
  device     String?
  createdAt  DateTime       @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([targetKind, targetId, type])
  @@index([userId, createdAt])
  @@index([visitorId, createdAt])
}
