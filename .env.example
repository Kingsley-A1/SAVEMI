# Database (CockroachDB / PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host:port/database?sslmode=require"

# Cloudflare R2 Storage
# These names must match exactly what src/lib/r2.ts reads at runtime.
CF_ACCOUNT_ID="your-cloudflare-account-id"
CF_ACCESS_KEY_ID="your-r2-access-key"
CF_SECRET_ACCESS_KEY="your-r2-secret-key"
CF_BUCKET="your-bucket-name"
# Public base URL for media. Point this at your R2 custom domain (subdomain)
# once it's connected in Cloudflare, e.g. https://media.savemionline.org
# All uploaded media (video/audio/images) is served from here.
CF_PUBLIC_BASE_URL="https://media.savemionline.org"

# Contact details and social handles — FALLBACKS ONLY.
# The ministry manages these from Admin -> Site Settings, which is stored in the
# database and takes effect without a redeploy. These values fill in for any
# setting that has not been saved there yet. Anything blank simply won't show.
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/people/Sabbath-Vesper-Ministry/61586401769698/"
NEXT_PUBLIC_FACEBOOK_HANDLE="Sabbath Vesper Ministry"
NEXT_PUBLIC_YOUTUBE_URL="https://www.youtube.com/@your-handle"
NEXT_PUBLIC_YOUTUBE_HANDLE="@your-handle"
# WhatsApp: full wa.me link OR a bare number with country code (e.g. 2348012345678)
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/2348012345678"
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_INSTAGRAM_HANDLE=""
NEXT_PUBLIC_TELEGRAM_URL=""
NEXT_PUBLIC_CONTACT_EMAIL="hello@savemionline.org"
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_ADDRESS="Calabar, Nigeria"

# NextAuth (Auth.js v5)
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin seed credentials (used by prisma/seed.cjs — development only)
# ADMIN_EMAIL must be set; there is no fallback in production. This is the
# super-admin and is always allowed to register/log in.
# ADMIN_ACCESS_CODE or ADMIN_PASSWORD must be exactly 6 characters.
ADMIN_EMAIL="admin@savemi.org"
ADMIN_PASSWORD="CHANGE"
ADMIN_NAME="SAVEMI Admin"

# Approved admin emails (comma-separated). Anyone on this list may self-register
# at /admin/register with the shared access code and choose their own name.
# ADMIN_EMAIL above is always allowed even if omitted here.
ADMIN_ALLOWED_EMAILS="admin@savemionline.org,second.admin@savemionline.org"

# Canonical public site URL — used to build email verification links.
NEXT_PUBLIC_SITE_URL="https://savemionline.org"

# Email delivery (Resend). Leave blank to disable all email (registration then
# auto-verifies admins and skips welcome/verification mail).
# RESEND_API_KEY starts with "re_". EMAIL_FROM must be a Resend-verified sender.
RESEND_API_KEY=""
EMAIL_FROM="SAVEMI <hello@savemionline.org>"
EMAIL_REPLY_TO="savemionline@gmail.com"
# Logo shown in the email masthead. Defaults to <site URL>/images/logo.jpg;
# override only if the logo is hosted elsewhere. Must be an absolute URL.
EMAIL_LOGO_URL=""
